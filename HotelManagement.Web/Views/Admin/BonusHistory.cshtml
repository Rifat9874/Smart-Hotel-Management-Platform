@model List<Row>
@{
    ViewData["Title"] = "Bonus history";
    var who = ViewData["Who"] as string ?? "";
}
<div class="container page" style="max-width:760px">
    <p><a asp-action="Staff">&larr; Staff &amp; salary</a></p>
    <h1>Bonus history</h1>
    <p class="muted">@who</p>

    @if (Model.Count == 0)
    {
        <div class="card empty">No bonuses recorded for this employee.</div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead><tr><th>Date</th><th class="num">Bonus (BDT)</th><th>Reason</th></tr></thead>
                <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td>@b.DateStr("PAYMENT_DATE")</td>
                        <td class="num">@b.Dec("BONUS_AMOUNT").ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</td>
                        <td>@(b.IsNull("BONUS_REASON") ? "" : b.Str("BONUS_REASON"))</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
