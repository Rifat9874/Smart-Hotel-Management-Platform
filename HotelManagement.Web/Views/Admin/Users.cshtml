@model UsersVm
@{
    ViewData["Title"] = "Users";
}
<div class="container page">
    <div class="page-head">
        <div>
            <h1>Users</h1>
            <p>Customers, staff, receptionists and admins.</p>
        </div>
        <a class="btn btn-gold" asp-action="AddEmployee">Add employee</a>
    </div>

    <div class="pill-row">
        <a class="pill @(Model.Type == "" ? "active" : "")" asp-action="Users">All</a>
        @foreach (var t in Lists.UserTypes)
        {
            <a class="pill @(Model.Type == t ? "active" : "")" asp-action="Users" asp-route-type="@t">@t</a>
        }
    </div>

    @if (Model.Users.Count == 0)
    {
        <div class="card empty">No users found.</div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead><tr><th>Name</th><th>Phone</th><th>Email</th><th>Type</th><th></th></tr></thead>
                <tbody>
                @foreach (var u in Model.Users)
                {
                    <tr>
                        <td>@u.Str("NAME")</td>
                        <td>@u.Str("PHONE_NUMBER")</td>
                        <td>@u.Str("EMAIL")</td>
                        <td><span class="badge b-info">@u.Str("USER_TYPE").ToUpperInvariant()</span></td>
                        <td class="right"><a class="btn btn-ghost btn-sm" asp-action="EditUser" asp-route-email="@u.Str("EMAIL")">Edit</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
