@model PayVm
@{
    ViewData["Title"] = "Payment successful";
    var b = Model.Booking;
    var id = b.Str("BOOKING_ID");
}
<div class="container page" style="max-width:640px">
    <div class="card center">
        <div class="success-tick">&#10003;</div>
        <h1>Payment successful</h1>
        <p class="muted">Thank you! Your booking #@id is confirmed.</p>

        <div style="text-align:left;margin:22px 0">
            <div class="summary-line"><span>Room</span><span>@b.Str("ROOM_ID") - @b.Str("TYPE")</span></div>
            <div class="summary-line"><span>Check-in</span><span>@b.DateStr("CHECK_IN")</span></div>
            <div class="summary-line"><span>Check-out</span><span>@b.DateStr("CHECK_OUT")</span></div>
            <div class="summary-line"><span>Status</span><span><span class="badge @Ui.Badge(b.Str("BOOKING_STATUS"))">@b.Str("BOOKING_STATUS")</span></span></div>
            <div class="summary-total"><span>Total</span><span>@Ui.Money(Model.Total)</span></div>
        </div>

        <div class="btn-row" style="justify-content:center">
            <a class="btn btn-gold" asp-action="Receipt" asp-route-id="@id">Download receipt (PDF)</a>
            <a class="btn btn-ghost" asp-controller="Profile" asp-action="Index">My bookings</a>
        </div>
    </div>
</div>
