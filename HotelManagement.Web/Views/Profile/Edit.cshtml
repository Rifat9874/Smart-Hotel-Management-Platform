@model Row
@{
    ViewData["Title"] = "Edit info";
    var error = ViewData["Error"] as string;
}
<div class="container page" style="max-width:560px">
    <div class="card">
        <h1>Edit my information</h1>
        @if (!string.IsNullOrEmpty(error))
        {
            <div class="flash flash-error" style="margin:0 0 16px">@error</div>
        }
        <form asp-action="Edit" method="post" class="stack">
            <div class="field">
                <label for="name">Full name</label>
                <input id="name" name="name" type="text" maxlength="50" value="@Model.Str("NAME")" required />
            </div>
            <div class="field">
                <label for="phone">Phone number</label>
                <input id="phone" name="phone" type="tel" inputmode="numeric" maxlength="11" value="@Model.Str("PHONE_NUMBER")" required />
            </div>
            <div class="field">
                <label>Email</label>
                <input type="email" value="@Model.Str("EMAIL")" disabled />
                <span class="hint">Your email is your login and cannot be changed.</span>
            </div>
            <div class="field">
                <label for="password">New password <span class="muted">(optional)</span></label>
                <input id="password" name="password" type="password" autocomplete="new-password" />
            </div>
            <div class="field">
                <label for="confirm">Confirm new password</label>
                <input id="confirm" name="confirm" type="password" autocomplete="new-password" />
            </div>
            <div class="btn-row">
                <button class="btn btn-gold" type="submit">Save</button>
                <a class="btn btn-ghost" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>
